# Copie este arquivo para ".env" e preencha com os valores do seu projeto
# Supabase (Project Settings → API). Sem isso, o app funciona normalmente,
# só que sem sincronizar entre aparelhos (fica só no localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Agenda (5.3) — opcional. Crie um projeto no Google Cloud Console em
# modo de teste, com você como único testador, e um OAuth Client ID do tipo
# "Web application" (sem client secret — o app roda só no navegador). Sem
# isso, a integração fica "não configurada" e o app segue funcionando normal,
# só sem sincronizar com o Google.
VITE_GOOGLE_CLIENT_ID=
# Id do calendário a usar — "primary" é o calendário principal da conta.
VITE_GOOGLE_CALENDAR_ID=primary
